# LLM provider - copy to .env and fill in your key
LLM_ENABLED=false
LLM_API_KEY=your-key-here
LLM_API_URL=https://opencode.ai/zen/go/v1
LLM_MODEL_ID=minimax-m2.7
LLM_TIMEOUT_SECONDS=30

# ML model path - set to the generated model artifact
# ML_MODEL_PATH=backend/models/corn_rf_v1.0.0_cc1f0282.joblib

# Database (for local dev with docker-compose)
BACKEND_DATABASE_URL=postgresql://agropredict:agropredict@localhost:5432/agropredict
BACKEND_REDIS_URL=redis://localhost:6379/0
